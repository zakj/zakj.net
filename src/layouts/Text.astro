---
import Base, { type Props as BaseProps } from '$layouts/Base.astro';
import Mark from '$components/Mark.astro';
import '$style/corner-light.css';
import '$style/page-grid.css';
import type { MarkdownLayoutProps } from 'astro';

type Props = BaseProps | MarkdownLayoutProps<BaseProps>;

const props: Props =
  'frontmatter' in Astro.props ? Astro.props.frontmatter : Astro.props;
---

<Base {...props}>
  <main>
    <header>
      <Mark />
      <h1>{props.title}</h1>
    </header>
    <slot />
  </main>
  <slot name="footer" />
</Base>

<style is:global>
  body {
    --column-width: var(--measure);

    container-type: inline-size;
    padding-bottom: max(env(safe-area-inset-bottom), var(--page-padding));
  }

  main {
    > header {
      align-items: baseline;
      display: flex;
      font-size: var(--font-size-h1);
      gap: 0.25em;

      /* The slash (0.64em) and gap hang into the left margin as far as the margin allows. */
      .mark {
        margin-left: calc(
          -1 *
            clamp(
              0px,
              (100cqi - var(--column-width)) / 2 - var(--page-padding),
              0.89em
            )
        );
      }
      h1 {
        font-size: inherit;
        text-transform: none;
      }
    }
  }

  main > * + *,
  main p,
  main h2 {
    margin-top: 0.7rem;
  }

  ul {
    padding-left: 1rem;
  }
</style>
