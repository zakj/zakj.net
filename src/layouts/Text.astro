---
import Base, { type Props as BaseProps } from '$layouts/Base.astro';
import Mark from '$components/Mark.astro';
import type { MarkdownLayoutProps } from 'astro';

type Props = BaseProps | MarkdownLayoutProps<BaseProps>;

const props: Props =
  'frontmatter' in Astro.props ? Astro.props.frontmatter : Astro.props;
---

<Base {...props}>
  <main>
    <header>
      <Mark />
      <h1>{props.title}</h1>
    </header>
    <slot />
  </main>
  <slot name="footer" />
</Base>

<style is:global>
  /* Registered so 50ch resolves against the body font, then inherits as a length. */
  @property --column-width {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  body {
    --column-width: 50ch;

    --color-bg-1: oklch(from var(--color-bg) 0.98 c h);
    --color-bg-2: oklch(from var(--color-accent) 0.2 c h / 0.1);

    background-image: linear-gradient(
      121deg,
      var(--color-bg-1) 60vh,
      var(--color-bg-2)
    );
    display: grid;
    grid-template-columns:
      [full-start]
      minmax(
        max(calc(env(safe-area-inset-left) + 0.5rem), var(--page-padding)),
        1fr
      )
      [content-start]
      minmax(auto, var(--column-width))
      [content-end]
      minmax(max(env(safe-area-inset-right), var(--page-padding)), 1fr)
      [full-end];
    container-type: inline-size;
    min-height: 100dvh;
    padding-top: max(env(safe-area-inset-top), var(--page-padding));
    padding-bottom: max(env(safe-area-inset-bottom), var(--page-padding));
  }

  main {
    grid-column: content;

    > header {
      align-items: baseline;
      display: flex;
      font-size: var(--font-size-h1);
      gap: 0.25em;

      /* The slash (0.64em) and gap hang into the left margin as far as the margin allows. */
      .mark {
        margin-left: calc(
          -1 *
            clamp(
              0px,
              (100cqi - var(--column-width)) / 2 - var(--page-padding),
              0.89em
            )
        );
      }
      h1 {
        font-size: inherit;
        text-transform: none;
      }
    }
  }

  main > * + *,
  main p,
  main h2 {
    margin-top: 0.7rem;
  }

  ul {
    padding-left: 1rem;
  }

  @media (prefers-color-scheme: dark) {
    body {
      --color-bg-1: oklch(from var(--color-bg) 0.24 c h);
      --color-bg-2: oklch(from var(--color-accent) 0.5 c h / 0.1);
    }
  }
</style>
