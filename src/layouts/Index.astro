---
import Base from '$layouts/Base.astro';

const props = Astro.props.frontmatter;
---

<script>
  (() => {
    const key = 'seenIndexAnimation';
    if (sessionStorage.getItem(key))
      document.body.classList.add('seen-animation');
    sessionStorage.setItem(key, '1');
    document
      .querySelector('footer')
      ?.addEventListener('animationend', () =>
        document.body.classList.add('seen-animation'),
      );
  })();
</script>

<Base {...props}>
  <header>
    <h1>{props.title}</h1>
    <p>{props.tagline}</p>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <a href="/colophon">Colophon</a>
  </footer>
  {/* Inline so the order is set during parsing, before fonts load and the fade-in starts. */}
  <script is:inline>
    document
      .querySelectorAll('header, main > *, footer')
      .forEach((el, i) => el.style.setProperty('--animate-order', i + 1));
  </script>
</Base>

<style is:global>
  :root {
    --page-padding: 1.5rem;
    --color-muted: color-mix(in oklch, var(--color-fg) 60%, var(--color-bg));
    --max-width: 1550px;
  }

  body {
    --light-x: max(0px, 50% - var(--max-width) / 2);

    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-inline: auto;
    max-width: var(--max-width);
    min-height: 100dvh;
    padding-block: max(env(safe-area-inset-top), var(--page-padding))
      max(env(safe-area-inset-bottom), var(--page-padding));
    padding-inline: max(env(safe-area-inset-left), var(--page-padding))
      max(env(safe-area-inset-right), var(--page-padding));

    /* Faint light falling from the top left of the column, behind the name. */
    &::before {
      background: radial-gradient(
        circle at var(--light-x) 0,
        transparent 20%,
        rgb(0 0 0 / 0.045) 90%
      );
      content: '';
      inset: 0;
      pointer-events: none;
      position: fixed;
      z-index: -1;
    }
  }

  header {
    h1 {
      font-size: fluid(46px, 72px, 390px, 750px);
      letter-spacing: -0.005em;
      text-transform: none;
    }
    p {
      color: var(--color-muted);
    }
  }

  main {
    max-width: 30em;
    text-wrap: pretty;

    p + p {
      margin-top: 0.7rem;
    }
  }

  a {
    text-decoration-color: oklch(from var(--color-accent) l c h / 0.4);
    @media (hover: hover) {
      &:hover {
        text-decoration-color: var(--color-accent);
      }
    }
  }

  footer {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    margin-top: auto;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-accent: oklch(from var(--color-shroom) 0.65 c h);
    }
    body::before {
      background: radial-gradient(
        circle at var(--light-x) 0,
        rgb(255 255 255 / 0.045) 10%,
        transparent 80%
      );
    }
  }

  @media screen and (min-width: 750px) and (min-height: 350px) {
    :root {
      --page-padding: 3rem;
    }
    body {
      gap: 3rem;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    :is(header, main > *, footer) {
      animation-delay: calc(var(--animate-order) * 75ms);
      animation-duration: 500ms;
      animation-fill-mode: forwards;
      animation-name: fade-in-text;
      opacity: 0;
    }
    body:is(.no-js, .loading, .seen-animation) :is(header, main > *, footer) {
      animation-name: none;
    }
    body.loading:not(.no-js) :is(header, main > *, footer) {
      opacity: 0;
    }
    body:is(.no-js, .seen-animation) :is(header, main > *, footer) {
      opacity: 1;
    }

    @keyframes fade-in-text {
      from {
        opacity: 0;
        transform: scale(1.04) translateY(-5px);
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
