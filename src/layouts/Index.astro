---
import Base from '$layouts/Base.astro';
import PhotoDate from '$components/PhotoDate.svelte';
import { getCollection } from 'astro:content';

const photos = (await getCollection('photos'))
  .map((entry) => entry.data)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

type Link = { href: string; title: string; desc: string };
const props: { title: string; tagline: string; links: Link[] } =
  Astro.props.frontmatter;
---

<script>
  (() => {
    const key = 'seenIndexAnimation';
    if (sessionStorage.getItem(key))
      document.body.classList.add('seen-animation');
    sessionStorage.setItem(key, '1');
    document
      .querySelector('footer')
      ?.addEventListener('animationend', () =>
        document.body.classList.add('seen-animation'),
      );
  })();
</script>

<Base {...props}>
  <header>
    <h1>{props.title}</h1>
    <p>{props.tagline}</p>
  </header>
  <main>
    <div class="bio">
      <slot />
    </div>
    <nav>
      <ul>
        {props.links.map(({ href, title, desc }) => (
          <li>
            <a href={href}>{title}</a>
            <p>{desc}</p>
          </li>
        ))}
      </ul>
    </nav>
  </main>
  <section class="photos">
    {photos.map((photo) => (
      <a
        href={`/photos/${photo.id}`}
        style={{
          '--aspect-ratio': photo.width / photo.height,
          '--placeholder': `url(${photo.placeholder})`,
        }}
      >
        <img
          src={photo.thumb.src}
          alt={photo.alt ?? ''}
          width={photo.thumb.width}
          height={photo.thumb.height}
          loading="lazy"
          decoding="async"
        />
        <PhotoDate date={photo.date} />
      </a>
    ))}
  </section>
  <footer>
    <a href="/colophon">Colophon</a>
  </footer>
  {/* Inline so the order is set during parsing, before fonts load and the fade-in starts. */}
  <script is:inline>
    document
      .querySelectorAll('header, .bio > *, nav, .photos, footer')
      .forEach((el, i) => el.style.setProperty('--animate-order', i + 1));
  </script>
</Base>

<style is:global>
  :root {
    --gap: 2rem;
    --max-width: 1550px;
  }

  body {
    --light-x: max(0px, 50% - var(--max-width) / 2);

    display: flex;
    flex-direction: column;
    gap: var(--gap);
    margin-inline: auto;
    max-width: var(--max-width);
    min-height: 100dvh;
    padding-block: max(env(safe-area-inset-top), var(--page-padding))
      max(env(safe-area-inset-bottom), var(--page-padding));
    padding-inline: max(env(safe-area-inset-left), var(--page-padding))
      max(env(safe-area-inset-right), var(--page-padding));

    /* Faint light falling from the top left of the column, behind the name. */
    &::before {
      background: radial-gradient(
        circle at var(--light-x) 0,
        transparent 20%,
        rgb(0 0 0 / 0.045) 90%
      );
      content: '';
      inset: 0;
      pointer-events: none;
      position: fixed;
      z-index: -1;
    }
  }

  header {
    h1 {
      font-size: fluid(46px, 72px, 390px, 750px);
      letter-spacing: -0.005em;
      text-transform: none;
    }
    p {
      color: var(--color-muted);
    }
  }

  main {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 5rem;
    text-wrap: pretty;
  }

  .bio {
    flex: 1 1 20em;
    max-width: 30em;

    p + p {
      margin-top: 0.7rem;
    }
  }

  nav {
    flex: 0 1 auto;

    ul {
      display: grid;
      gap: 0.7rem;
      list-style: none;
      padding: 0;
    }
    p {
      color: var(--color-muted);
      font-size: 0.8em;
    }
  }

  a {
    text-decoration-color: oklch(from var(--color-accent) l c h / 0.4);
    @media (hover: hover) {
      &:hover {
        text-decoration-color: var(--color-accent);
      }
    }
  }

  .photos {
    display: flex;
    gap: 6px;
    margin-top: auto;

    a {
      aspect-ratio: var(--aspect-ratio);
      background: var(--placeholder) center / cover;
      flex: var(--aspect-ratio) 1 0%;
      min-width: 0;
      position: relative;
    }
    img {
      height: 100%;
      object-fit: cover;
      width: 100%;
    }
  }

  footer {
    color: var(--color-muted);
    font-size: 0.8em;
    margin-top: calc(0.75rem - var(--gap));
    text-align: right;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-accent: oklch(from var(--color-shroom) 0.65 c h);
    }
    body::before {
      background: radial-gradient(
        circle at var(--light-x) 0,
        rgb(255 255 255 / 0.045) 10%,
        transparent 80%
      );
    }
  }

  @media screen and (min-width: 750px) and (min-height: 350px) {
    :root {
      --gap: 3rem;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    :is(header, .bio > *, nav, .photos, footer) {
      animation-delay: calc(var(--animate-order) * 75ms);
      animation-duration: 500ms;
      animation-fill-mode: forwards;
      animation-name: fade-in-text;
      opacity: 0;
    }
    body:is(.no-js, .loading, .seen-animation)
      :is(header, .bio > *, nav, .photos, footer) {
      animation-name: none;
    }
    body.loading:not(.no-js) :is(header, .bio > *, nav, .photos, footer) {
      opacity: 0;
    }
    body:is(.no-js, .seen-animation)
      :is(header, .bio > *, nav, .photos, footer) {
      opacity: 1;
    }

    @keyframes fade-in-text {
      from {
        opacity: 0;
        transform: scale(1.04) translateY(-5px);
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
