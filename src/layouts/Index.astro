---
import Base from '$layouts/Base.astro';
import Mark from '$components/Mark.astro';
import PhotoDate from '$components/PhotoDate.svelte';
import '$style/corner-light.css';
import { getCollection } from 'astro:content';

const photos = (await getCollection('photos'))
  .map((entry) => entry.data)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);
const ratioSum = photos.reduce((sum, p) => sum + p.width / p.height, 0);
// The mark's slash runs this far across for every 1 up (Mark.astro's polygon).
const slant = 0.598;

type Link = { href: string; title: string; desc: string };
const props: { title: string; tagline: string; links: Link[] } =
  Astro.props.frontmatter;
---

<script>
  (() => {
    const key = 'seenIndexAnimation';
    if (sessionStorage.getItem(key))
      document.body.classList.add('seen-animation');
    sessionStorage.setItem(key, '1');
    document
      .querySelector('.photos')
      ?.addEventListener('animationend', () =>
        document.body.classList.add('seen-animation'),
      );
  })();
</script>

<Base {...props}>
  <header>
    <h1>
      <Mark z />
      {props.title.slice(1)}
    </h1>
    <p>{props.tagline}</p>
  </header>
  <main>
    <div class="bio">
      <slot />
    </div>
    <nav>
      <ul>
        {props.links.map(({ href, title, desc }) => (
          <li>
            <a href={href}>{title}</a>
            <p>{desc}</p>
          </li>
        ))}
        <li class="colophon">
          <a href="/colophon">Colophon</a>
        </li>
      </ul>
    </nav>
  </main>
  <section
    class="photos"
    style={{
      '--ratio-sum': ratioSum,
      '--seams': photos.length - 1,
      '--slant': slant,
    }}
  >
    {photos.map((photo) => (
      <a
        href={`/photos/${photo.id}`}
        style={{
          '--aspect-ratio': photo.width / photo.height,
          '--placeholder': `url(${photo.placeholder})`,
          '--focal-x': photo.focal.x,
          '--focal-y': photo.focal.y,
        }}
      >
        <img
          src={photo.thumb.src}
          srcset={photo.thumb.srcset}
          sizes={`calc(min(100vw, 1550px) * ${(photo.width / photo.height + slant) / ratioSum})`}
          alt={photo.alt ?? ''}
          width={photo.thumb.width}
          height={photo.thumb.height}
          loading="lazy"
          decoding="async"
        />
        <PhotoDate date={photo.date} />
      </a>
    ))}
  </section>
  {/* Inline so the order is set during parsing, before fonts load and the fade-in starts. */}
  <script is:inline>
    document
      .querySelectorAll('header, .bio > *, nav, .photos')
      .forEach((el, i) => el.style.setProperty('--animate-order', i + 1));
    // Arriving via a view transition, skip the fade-in so it doesn't fight the mark moving in.
    addEventListener('pagereveal', (e) => {
      if (e.viewTransition) document.body.classList.add('seen-animation');
    });
  </script>
</Base>

<style is:global>
  :root {
    --gap: 2rem;
    --max-width: 1550px;
  }

  body {
    --light-x: max(0px, 50% - var(--max-width) / 2);

    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    margin-inline: auto;
    max-width: var(--max-width);
    min-height: 100dvh;
    padding-block: max(env(safe-area-inset-top), var(--page-padding))
      max(env(safe-area-inset-bottom), var(--page-padding));
    padding-inline: max(env(safe-area-inset-left), var(--page-padding))
      max(env(safe-area-inset-right), var(--page-padding));
  }

  header {
    h1 {
      font-size: fluid(46px, 72px, 390px, 750px);
      letter-spacing: -0.005em;
      text-transform: none;
    }
    p {
      color: var(--color-muted);
    }
  }

  main {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 5rem;
    text-wrap: pretty;
  }

  .bio {
    flex: 1 1 20em;
    max-width: var(--measure);

    p + p {
      margin-top: 0.7rem;
    }
  }

  nav {
    flex: 0 1 auto;

    ul {
      display: grid;
      gap: 0.7rem;
      list-style: none;
      padding: 0;
    }
    p,
    .colophon {
      color: var(--color-muted);
      font-size: 0.8em;
    }
    .colophon a {
      color: inherit;
    }
  }

  /* Registered so it resolves against the page width here, not each photo's own container below. */
  @property --run {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  /* Seams run at the mark's slash angle. Each photo is widened by what the slant
     clips off, so its visible area keeps its aspect ratio. */
  .photos {
    --seam: 6px;
    --height: calc((100cqi - var(--seam) * var(--seams)) / var(--ratio-sum));
    --run: calc(var(--height) * var(--slant));

    display: flex;
    height: var(--height);
    margin-top: auto;

    a {
      /* Which sides are slanted; the end photos keep their outer edge straight. */
      --fl: 1;
      --fr: 1;
      --l: calc(var(--run) * var(--fl));
      --r: calc(var(--run) * var(--fr));

      clip-path: polygon(
        var(--l) 0,
        100% 0,
        calc(100% - var(--r)) 100%,
        0 100%
      );
      container-type: size;
      flex: 0 1
        calc(var(--aspect-ratio) * var(--height) + (var(--l) + var(--r)) / 2);
      min-width: 0;
      position: relative;

      time {
        right: var(--r);
      }
    }
    a:first-child {
      --fl: 0;
    }
    a:last-child {
      --fr: 0;
    }
    a + a {
      margin-left: calc(var(--seam) - var(--run));
    }

    /* An outline can't follow the slant, so focus draws a band just inside the
       slice's edges instead: a box, which the slice's clip trims to its shape,
       minus that shape inset by the band. */
    a:focus-visible {
      outline: none;

      &::after {
        --t: 3px;
        /* A slanted edge must move further sideways to inset by the same width. */
        --hyp: sqrt(1 + var(--slant) * var(--slant));
        --dl: calc(var(--t) * (1 + var(--fl) * (var(--hyp) - 1)));
        --dr: calc(var(--t) * (1 + var(--fr) * (var(--hyp) - 1)));
        --sl: calc(var(--fl) * var(--slant) * var(--t));
        --sr: calc(var(--fr) * var(--slant) * var(--t));

        background: var(--color-accent);
        clip-path: polygon(
          evenodd,
          0 0,
          100% 0,
          100% 100%,
          0 100%,
          0 0,
          calc(var(--l) - var(--sl) + var(--dl)) var(--t),
          calc(100% - var(--sr) - var(--dr)) var(--t),
          calc(100% - var(--r) + var(--sr) - var(--dr)) calc(100% - var(--t)),
          calc(var(--sl) + var(--dl)) calc(100% - var(--t)),
          calc(var(--l) - var(--sl) + var(--dl)) var(--t)
        );
        content: '';
        inset: 0;
        position: absolute;
      }
    }

    /* Cover, with the focal point as close to the center of the visible shape as
       the edges allow. The slants shift that center (l - r) / 4 off the box's. */
    img {
      --w: max(100cqw, 100cqh * var(--aspect-ratio));
      --h: max(100cqh, 100cqw / var(--aspect-ratio));
      --pos: clamp(
          100cqw - var(--w),
          50cqw + (var(--l) - var(--r)) / 4 - var(--focal-x) * var(--w),
          0px
        )
        clamp(100cqh - var(--h), 50cqh - var(--focal-y) * var(--h), 0px);
      background: var(--placeholder) var(--pos) / cover;
      height: 100%;
      object-fit: cover;
      object-position: var(--pos);
      width: 100%;
    }
  }

  @media screen and (min-width: 750px) and (min-height: 350px) {
    :root {
      --gap: 3rem;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    :is(header, .bio > *, nav, .photos) {
      animation-delay: calc(var(--animate-order) * 75ms);
      animation-duration: 500ms;
      animation-fill-mode: forwards;
      animation-name: fade-in-text;
      opacity: 0;
    }
    body:is(.no-js, .loading, .seen-animation)
      :is(header, .bio > *, nav, .photos) {
      animation-name: none;
    }
    body.loading:not(.no-js) :is(header, .bio > *, nav, .photos) {
      opacity: 0;
    }
    body:is(.no-js, .seen-animation) :is(header, .bio > *, nav, .photos) {
      opacity: 1;
    }

    @keyframes fade-in-text {
      from {
        opacity: 0;
        transform: scale(1.04) translateY(-5px);
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
