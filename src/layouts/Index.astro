---
import Base from '$layouts/Base.astro';
import Mark from '$components/Mark.astro';
import PhotoDate from '$components/PhotoDate.svelte';
import '$style/corner-light.css';
import '$style/focal-crop.css';
import { getCollection } from 'astro:content';

const photos = (await getCollection('photos'))
  .map((entry) => entry.data)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);
const ratioSum = photos.reduce((sum, p) => sum + p.width / p.height, 0);
// The mark's slash runs this far across for every 1 up (Mark.astro's polygon).
const slant = 0.598;

// The width a photo renders at, mirroring the row's flex layout: its share of the
// row at height h, where a slanted side adds half a slant, plus its flex-grow share
// of whatever width is left once 40svh caps h.
const row = `(min(100vw, 1382px) - ${(photos.length - 1) * 6}px)`;
const height = `min(40svh, ${row} / ${ratioSum})`;
const growSum = ratioSum + photos.length * slant;
const sizes = (ratio: number, slantedSides: number) => {
  const grow = (ratio + slant) / growSum;
  const perHeight = ratio + (slant * slantedSides) / 2 - ratioSum * grow;
  return `calc(${height} * ${perHeight.toFixed(4)} + ${row} * ${grow.toFixed(4)})`;
};

type Link = { href: string; title: string; desc: string };
const props: { title: string; tagline: string; links: Link[] } =
  Astro.props.frontmatter;
---

<script>
  (() => {
    const key = 'seenIndexAnimation';
    if (sessionStorage.getItem(key))
      document.body.classList.add('seen-animation');
    sessionStorage.setItem(key, '1');
    document
      .querySelector('.photos')
      ?.addEventListener('animationend', () =>
        document.body.classList.add('seen-animation'),
      );
  })();
</script>

<Base {...props}>
  <header>
    <h1>
      <Mark z />
      {props.title.slice(1)}
    </h1>
    <p>{props.tagline}</p>
  </header>
  <main>
    <div class="bio">
      <slot />
    </div>
    <nav>
      <ul>
        {props.links.map(({ href, title, desc }) => (
          <li>
            <a href={href}>{title}</a>
            <p>{desc}</p>
          </li>
        ))}
        <li class="colophon">
          <a href="/colophon">Colophon</a>
        </li>
      </ul>
    </nav>
  </main>
  <section
    class="photos"
    style={{
      '--ratio-sum': ratioSum,
      '--seams': photos.length - 1,
      '--slant': slant,
    }}
  >
    {photos.map((photo, i) => (
      <a
        class="focal-crop"
        href={`/photos/${photo.id}`}
        style={{
          '--aspect-ratio': photo.width / photo.height,
          '--placeholder': `url(${photo.placeholder})`,
          '--focal-x': photo.focal.x,
          '--focal-y': photo.focal.y,
        }}
      >
        <img
          src={photo.thumb.src}
          srcset={photo.thumb.srcset}
          sizes={sizes(
            photo.width / photo.height,
            Number(i > 0) + Number(i < photos.length - 1),
          )}
          alt={photo.alt ?? ''}
          width={photo.thumb.width}
          height={photo.thumb.height}
          decoding="async"
        />
        <PhotoDate date={photo.date} />
      </a>
    ))}
  </section>
  {/* Inline so the order is set during parsing, before fonts load and the fade-in starts.
      The same elements as the fade-in rule below. */}
  <script is:inline>
    document
      .querySelectorAll('header, .bio > *, nav, .photos')
      .forEach((el, i) => el.style.setProperty('--animate-order', i + 1));
    // Arriving via a view transition, skip the fade-in so it doesn't fight the mark moving in.
    addEventListener('pagereveal', (e) => {
      if (e.viewTransition) document.body.classList.add('seen-animation');
    });
  </script>
</Base>

<style is:global>
  :root {
    --gap: 2rem;
    --max-width: 1550px;
  }

  /* Text sits in the middle column; the photos can span the full width. The
     middle row grows to fill a tall window, so the photos sit on its bottom edge. */
  body {
    --column: calc(var(--max-width) - 2 * var(--page-padding));
    --light-x: max(0px, 50% - var(--max-width) / 2);

    display: grid;
    grid-template-columns:
      [full-start] minmax(
        max(env(safe-area-inset-left), var(--page-padding)),
        1fr
      )
      [content-start] minmax(0, var(--column))
      [content-end] minmax(
        max(env(safe-area-inset-right), var(--page-padding)),
        1fr
      )
      [full-end];
    grid-template-rows: auto 1fr auto;
    min-height: 100dvh;
    padding-top: max(env(safe-area-inset-top), var(--page-padding));
    row-gap: var(--gap);

    > * {
      grid-column: content;
    }
  }

  header {
    h1 {
      font-size: fluid(46px, 72px, 390px, 750px);
      letter-spacing: -0.005em;
      text-transform: none;
    }
    p {
      color: var(--color-muted);
    }
  }

  main {
    align-content: start;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 5rem;
    text-wrap: pretty;
  }

  .bio {
    flex: 1 1 20em;
    max-width: var(--measure);

    p + p {
      margin-top: 0.7rem;
    }
  }

  nav {
    flex: 0 1 auto;

    ul {
      display: grid;
      gap: 0.7rem;
      list-style: none;
      padding: 0;
    }
    p,
    .colophon {
      color: var(--color-muted);
      font-size: 0.8em;
    }
    .colophon a {
      color: inherit;
    }
  }

  /* Seams run at the mark's slash angle. Each photo is widened by what the slant
     clips off, so its visible area keeps its aspect ratio. The photos are the
     page's floor: full-bleed and flush to the bottom, until the window is wider
     than --column; then they stop at that width, lifted by a seam. */
  /* Registered so 100cqi resolves on each photo, against the row, rather than
     inside the photo's own container where its contents use what derives from it. */
  @property --height {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  .photos {
    --seam: 6px;

    container-type: inline-size;
    display: flex;
    grid-column: full;
    justify-self: center;
    /* Once the row stops at the column's edges, lift it off the bottom by a seam too. */
    margin-bottom: clamp(0px, 100% - var(--column), var(--seam));
    width: min(100%, var(--column));

    a {
      --height: min(
        calc((100cqi - var(--seam) * var(--seams)) / var(--ratio-sum)),
        40svh
      );
      --run: calc(var(--height) * var(--slant));
      /* Which sides are slanted; the end photos keep their outer edge straight. */
      --fl: 1;
      --fr: 1;
      --l: calc(var(--run) * var(--fl));
      --r: calc(var(--run) * var(--fr));
      /* Center the focal point in the visible shape, which the slants shift off the box's center. */
      --focal-shift-x: calc((var(--l) - var(--r)) / 4);

      clip-path: polygon(
        var(--l) 0,
        100% 0,
        calc(100% - var(--r)) 100%,
        0 100%
      );
      flex: calc(var(--aspect-ratio) + var(--slant)) 1
        calc(var(--aspect-ratio) * var(--height) + (var(--l) + var(--r)) / 2);
      height: var(--height);
      min-width: 0;
      position: relative;

      time {
        right: var(--r);
      }
    }
    a:first-child {
      --fl: 0;
    }
    a:last-child {
      --fr: 0;
    }
    a + a {
      margin-left: calc(var(--seam) - var(--run));
    }

    /* An outline can't follow the slant, so focus draws a band just inside the
       slice's edges instead: a box, which the slice's clip trims to its shape,
       minus that shape inset by the band. */
    a:focus-visible {
      outline: none;

      &::after {
        --t: 3px;
        /* A slanted edge must move further sideways to inset by the same width. */
        --hyp: sqrt(1 + var(--slant) * var(--slant));
        --dl: calc(var(--t) * (1 + var(--fl) * (var(--hyp) - 1)));
        --dr: calc(var(--t) * (1 + var(--fr) * (var(--hyp) - 1)));
        --sl: calc(var(--fl) * var(--slant) * var(--t));
        --sr: calc(var(--fr) * var(--slant) * var(--t));

        background: var(--color-accent);
        clip-path: polygon(
          evenodd,
          0 0,
          100% 0,
          100% 100%,
          0 100%,
          0 0,
          calc(var(--l) - var(--sl) + var(--dl)) var(--t),
          calc(100% - var(--sr) - var(--dr)) var(--t),
          calc(100% - var(--r) + var(--sr) - var(--dr)) calc(100% - var(--t)),
          calc(var(--sl) + var(--dl)) calc(100% - var(--t)),
          calc(var(--l) - var(--sl) + var(--dl)) var(--t)
        );
        content: '';
        inset: 0;
        position: absolute;
      }
    }

    img {
      background: var(--placeholder) var(--focal-position) / cover;
      height: 100%;
      object-fit: cover;
      object-position: var(--focal-position);
      width: 100%;
    }
  }

  @media screen and (min-width: 750px) and (min-height: 350px) {
    :root {
      --gap: 3rem;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    /* Keep in sync with the --animate-order script. */
    :is(header, .bio > *, nav, .photos) {
      animation-delay: calc(var(--animate-order) * 75ms);
      animation-duration: 500ms;
      animation-fill-mode: forwards;
      animation-name: fade-in-text;
      opacity: 0;

      body:is(.loading, .seen-animation) & {
        animation-name: none;
      }
      body.loading:not(.no-js) & {
        opacity: 0;
      }
      body:is(.no-js, .seen-animation) & {
        opacity: 1;
      }
    }

    @keyframes fade-in-text {
      from {
        opacity: 0;
        transform: scale(1.04) translateY(-5px);
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
