<a class="mark" href="/" aria-label="Home">
  <svg viewBox="7 0 640 700" aria-hidden="true">
    <polygon class="bar top" points="50,0 465.68,0 364,170 50,170"></polygon>
    <polygon
      class="bar bottom"
      points="292,530 625,530 625,700 190.96,700"
    ></polygon>
    <polygon points="7,700 230.96,700 647,0 425.68,0"></polygon>
  </svg>
</a>

<style>
  /* At rest the mark is a "/", the site root; it finishes into a Z on hover, focus, or press. */
  .mark {
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Sized to GT Walsheim's cap height, so it matches a Walsheim heading set at the same size. */
  svg {
    display: inline;
    fill: currentColor;
    height: 0.7em;
    width: auto;
  }

  .bar {
    transform: scaleX(0);
    transform-box: fill-box;
    transition: transform 220ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  .top {
    transform-origin: 100% 50%;
    /* Leaving retracts in reverse: bottom first, then top. */
    transition-delay: 70ms;
  }
  .bottom {
    transform-origin: 0% 50%;
  }

  @media (hover: hover) {
    .mark:hover .bar {
      transform: none;
    }
    .mark:hover .top {
      transition-delay: 0ms;
    }
    .mark:hover .bottom {
      transition-delay: 70ms;
    }
  }
  .mark:is(:focus-visible, :active) {
    .bar {
      transform: none;
    }
    .top {
      transition-delay: 0ms;
    }
    .bottom {
      transition-delay: 70ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }
</style>
