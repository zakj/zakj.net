---
import Photos_ from '$components/Photos.svelte';
import Mark from '$components/Mark.astro';
import Base from '$layouts/Base.astro';
import { getCollection } from 'astro:content';

const photos = (await getCollection('photos')).map((entry) => entry.data);
---

<Base title="Photos" description="My local Instagram." webApp>
  <Fragment slot="extra-head">
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Photos · zakj.net"
      href={new URL('/photos/feed.xml', Astro.site)}
    />
  </Fragment>
  <Photos_ images={photos} client:idle>
    <Mark slot="mark" />
  </Photos_>
</Base>
